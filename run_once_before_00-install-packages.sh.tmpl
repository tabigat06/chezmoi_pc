#!/usr/bin/env bash
# Этот файл выполняется chezmoi ОДИН РАЗ при первом `chezmoi apply` на машине
# (имя начинается с run_once_ — chezmoi сам это отслеживает).
#
# Идемпотентно: apt install уже установленных пакетов ничего не ломает,
# так что скрипт безопасно перезапускать вручную, если что-то не доустановилось:
#   chezmoi cd && ./run_once_before_00-install-packages.sh.tmpl
set -euo pipefail

DEBIAN_RELEASE="trixie"   # поменяй на bookworm/testing/sid, если у тебя не Debian 13

echo "==> Обновляю apt и ставлю базовые пакеты"
sudo apt update
sudo apt install -y curl gpg ca-certificates

echo "==> Ставлю пакеты из packages/apt.txt"
PKG_LIST="{{ .chezmoi.sourceDir }}/packages/apt.txt"
if [ -f "$PKG_LIST" ]; then
  # убираем комментарии и пустые строки
  PACKAGES=$(grep -vE '^\s*#|^\s*$' "$PKG_LIST" | tr '\n' ' ')
  sudo apt install -y $PACKAGES
else
  echo "Файл $PKG_LIST не найден, пропускаю"
fi

echo "==> Репозиторий backports (нужен для quickshell на Debian 13)"
if [ ! -f /etc/apt/sources.list.d/trixie-backports.list ]; then
  echo "deb http://deb.debian.org/debian ${DEBIAN_RELEASE}-backports main" | \
    sudo tee /etc/apt/sources.list.d/trixie-backports.list
fi

sudo mkdir -p /etc/apt/keyrings

# Проверяем не по имени своего файла, а по тому, упоминается ли уже сам URL
# репозитория ГДЕ УГОДНО в sources.list.d — так скрипт не конфликтует с
# репозиториями, которые ты (или официальный dms-установщик) мог добавить
# раньше под другим именем файла/keyring.
repo_already_added() {
  grep -rlq "$1" /etc/apt/sources.list.d/ 2>/dev/null
}

echo "==> Репозиторий DankLinux (niri, quickshell-git и компаньоны)"
if repo_already_added "AvengeMedia:/danklinux"; then
  echo "Уже подключён (найден в /etc/apt/sources.list.d/), пропускаю добавление."
else
  curl -fsSL "https://download.opensuse.org/repositories/home:AvengeMedia:danklinux/Debian_13/Release.key" | \
    sudo gpg --dearmor -o /etc/apt/keyrings/danklinux.gpg
  echo "deb [signed-by=/etc/apt/keyrings/danklinux.gpg] https://download.opensuse.org/repositories/home:/AvengeMedia:/danklinux/Debian_13/ /" | \
    sudo tee /etc/apt/sources.list.d/danklinux.list
fi

echo "==> Репозиторий DMS (DankMaterialShell)"
if repo_already_added "AvengeMedia:/dms"; then
  echo "Уже подключён (найден в /etc/apt/sources.list.d/), пропускаю добавление."
else
  curl -fsSL "https://download.opensuse.org/repositories/home:AvengeMedia:dms/Debian_13/Release.key" | \
    sudo gpg --dearmor -o /etc/apt/keyrings/dms.gpg
  echo "deb [signed-by=/etc/apt/keyrings/dms.gpg] https://download.opensuse.org/repositories/home:/AvengeMedia:/dms/Debian_13/ /" | \
    sudo tee /etc/apt/sources.list.d/dms.list
fi

sudo apt update
sudo apt install -y quickshell-git niri dms

echo "==> Первичная генерация конфигов DMS для niri (если ещё не сгенерированы)"
# dms setup создаёт стартовые конфиги niri/foot под DMS — если у тебя уже
# есть свои конфиги в этом репозитории, они перезапишутся chezmoi apply ПОСЛЕ
# этого шага, так что порядок безопасен.
command -v dms >/dev/null 2>&1 && dms setup || true

echo "==> Меняю дефолтный shell на zsh"
if [ "$SHELL" != "$(command -v zsh)" ]; then
  sudo chsh -s "$(command -v zsh)" "$(whoami)"
fi

echo "==> Готово. Конфиги применит chezmoi после этого скрипта."
